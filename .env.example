# .env로 복사해서 쓰세요. 모두 선택 사항이에요.
# Kaggle 토큰은 여기 말고 ~/.kaggle/access_token 에 두세요.

# 1이면 Kaggle 없이 가짜 영상으로 화면만 테스트
LH_DRY_RUN=0
# Kaggle에 만들어질 노트북 이름
LH_KERNEL_SLUG=local-higgs-worker
# 사용할 모델 (Hugging Face)
LH_MODEL_ID=Wan-AI/Wan2.2-TI2V-5B-Diffusers
# 한 번의 GPU 세션에 넣을 최대 작업 수
LH_MAX_BATCH=4
# 작업을 모으는 대기 시간(초). 여러 개를 연달아 누르면 한 번에 보냄
LH_BATCH_WAIT_SECONDS=20
# 진행 상황 확인 주기(초)
LH_POLL_SECONDS=30
# Kaggle 세션 최대 시간(초)
LH_SESSION_TIMEOUT=14400
